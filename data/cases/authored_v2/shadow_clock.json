  "act_id": "ACT_4",
  "title": {"en": "Shadow Mark: Clock", "ko": "그림자 표식: 시계"},
  "briefing": {
    "en": "Veteran restorer Mara Venn presents a Kestrel Model 130 clock whose movement carries a black service triangle. The clock is period, but a clean-running escapement raises the question of when and how it was repaired.",
    "ko": "베테랑 수복가 마라 벤은 기구부에 검은 정비 삼각형이 있는 케스트럴 모델 130 시계를 내놓았다. 시계는 당대 물건이지만 매끄럽게 도는 탈진기가 언제 어떤 방식으로 수리됐는지 밝혀야 한다."
  },
  "central_question": {
    "en": "Is the clock untouched, a genuine Kestrel with a period escapement repair, or a later reconstruction inside an old case?",
    "ko": "이 시계는 손대지 않은 원형인가, 당대 탈진기 수리를 받은 케스트럴 진품인가, 아니면 오래된 케이스 안에 만든 후대 재구성품인가?"
  },
  "fiction_notice": {
    "en": "All makers, records, people, service marks, and dates in this case are fictional in-world material.",
    "ko": "이 사건의 제작사, 기록, 인물, 정비 표식과 연대는 모두 게임 세계관을 위해 창작된 자료다."
  },
  "success": {
    "en": "The report authenticates the Kestrel clock and dates its escapement repair to the instrument's working period.",
    "ko": "보고서는 케스트럴 시계를 진품으로 확인하고 탈진기 수리를 기구의 사용 시기로 연대 판정한다."
  },
  "failure": {
    "en": "The clock remains in review while Mara Venn reconstructs the service sequence with the player.",
    "ko": "시계는 검토 상태로 남고, 마라 벤은 플레이어와 함께 정비 순서를 다시 구성한다."
  },
  "unlock": {
    "op": "always",
    "player_hint": {"en": "Open the clock file from the Stage 6 campaign desk.", "ko": "스테이지 6 캠페인 책상에서 시계 사건 서류를 연다."}
  },
