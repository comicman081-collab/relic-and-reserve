  "active": true,
  "case_id": "shadow_optic",
  "act_id": "ACT_4",
  "title": {"en": "Shadow Mark: Optic", "ko": "그림자 표식: 광학 기구"},
  "briefing": {
    "en": "Victor Hale brings a Quillmark-pattern telescope whose darkened tube and neat maker plate suggest a preserved period instrument. The optics look convincing, but the finish and fittings tell a less settled story.",
    "ko": "빅터 헤일은 어두운 경통과 반듯한 제작사 명판 때문에 당대품처럼 보이는 퀼마크 양식 망원경을 가져왔다. 광학계는 그럴듯하지만 표면과 체결부의 이력은 분명하지 않다."
  },
  "central_question": {
    "en": "Is this a genuine period telescope, a genuine body with later optical repair, or a later reproduction made in period style?",
    "ko": "이 물건은 당대 진품 망원경인가, 후대에 광학계만 수리한 진품 몸체인가, 아니면 당대 양식으로 만든 후대 복제품인가?"
  },
  "fiction_notice": {
    "en": "All makers, records, people, marks, and dates in this case are fictional in-world material.",
    "ko": "이 사건의 제작사, 기록, 인물, 표식과 연대는 모두 게임 세계관을 위해 창작된 자료다."
  },
  "success": {
    "en": "The report identifies the later reproduction and explains why an orderly recent custody chain does not make it a period original.",
    "ko": "보고서는 후대 복제품을 가려내고, 최근의 정돈된 소장 경로만으로 당대 원품이 될 수 없는 이유를 설명한다."
  },
  "failure": {
    "en": "The telescope remains under review while Victor helps separate visual resemblance from material age and documented custody.",
    "ko": "망원경은 검토 상태로 남고, 빅터는 닮은 외형과 재료의 연대, 기록된 소장 경로를 구분하도록 돕는다."
  },
  "unlock": {
    "op": "always",
    "player_hint": {"en": "Open the optic file from the Stage 7 campaign desk.", "ko": "스테이지 7 캠페인 책상에서 광학 기구 사건 서류를 연다."}
  },
