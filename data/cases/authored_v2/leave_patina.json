  "hypotheses": [
    {
      "id": "hyp.leave_patina.natural_patina",
      "label": {
        "en": "Natural patina",
        "ko": "자연 파티나"
      },
      "claim": {
        "en": "The stable dark layer developed gradually through ordinary handling and storage; only a small later residue sits above it.",
        "ko": "안정된 짙은 층은 오랜 사용과 보관 과정에서 서서히 생겼으며 그 위에 소량의 후대 잔류물만 놓여 있다."
      }
    },
    {
      "id": "hyp.leave_patina.later_contamination",
      "label": {
        "en": "Later contamination",
        "ko": "후대 오염"
      },
      "claim": {
        "en": "Most of the dark appearance comes from a later wax-and-soot film rather than the object's own aged finish.",
        "ko": "짙은 외관의 대부분은 물건 자체의 오래된 마감이 아니라 후대에 묻은 왁스와 그을음 막에서 비롯되었다."
      }
    },
    {
      "id": "hyp.leave_patina.artificial_aging",
      "label": {
        "en": "Artificial aging",
        "ko": "인위적 노화"
      },
      "claim": {
        "en": "A recent owner deliberately colored and abraded the surface to imitate age before sale.",
        "ko": "최근 소유자가 판매 전에 오래된 물건처럼 보이도록 표면을 의도적으로 착색하고 마모시켰다."
      }
    }
  ],
  "sources": [
    {
      "source_ref": "src.leave_patina.artifact.wear_gradient",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_005",
      "reliability": "HIGH",
      "label": {
        "en": "Handling wear gradient",
        "ko": "손길에 따른 마모 변화"
      },
      "text": {
        "en": "The lid edge and winding side are lighter where fingers repeatedly touched them, while protected recesses remain dark. Fine scratches cross both tones without stopping at the color boundary, indicating gradual wear rather than a recently painted antique effect.",
        "ko": "손가락이 반복해서 닿은 뚜껑 가장자리와 태엽 쪽은 밝고, 오목하게 보호된 곳은 짙다. 미세한 흠집은 색 경계에서 끊기지 않고 두 색조를 함께 지나가 최근 칠한 노화 효과보다 점진적 마모를 보여 준다."
      },
      "unlock": {
        "action": "inspect",
        "target": "handling_surfaces",
        "requires": []
      },
      "risk": {
        "destroyed_by": []
      },
      "independence": {
        "group": "physical_wear_sequence",
        "depends_on": []
      },
      "citation_id": "cite.leave_patina.artifact.wear_gradient"
    },
    {
      "source_ref": "src.leave_patina.artifact.hidden_finish_boundary",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_005",
      "reliability": "HIGH",
      "label": {
        "en": "Protected finish boundary",
        "ko": "가려진 마감층 경계"
      },
      "text": {
        "en": "A dry-cloth test beside the rear hinge lifts a thin amber residue but leaves the coherent brown layer below unchanged. Under the hinge leaf, that lower layer continues evenly and shows no pooled pigment or brush edge.",
        "ko": "뒤 경첩 옆을 마른 천으로 시험하자 얇은 호박색 잔류물만 묻어나고 아래의 단단한 갈색 층은 그대로 남는다. 경첩 날개 아래에서도 그 아래층은 고르게 이어지며 안료가 고이거나 붓자국이 생긴 흔적은 없다."
      },
      "unlock": {
        "action": "surface_test",
        "target": "rear_hinge_margin",
        "requires": [
          "src.leave_patina.artifact.wear_gradient",
          "cleaning_cloth"
        ]
      },
      "risk": {
        "destroyed_by": [],
        "player_warning": {
          "en": "Test one marked margin only; broad wiping would erase the residue boundary before it is recorded.",
          "ko": "표시한 가장자리 한 곳만 시험하라. 넓게 닦으면 기록 전에 잔류물 경계가 사라진다."
        }
      },
      "independence": {
        "group": "protected_finish_layer",
        "depends_on": [
          "src.leave_patina.artifact.wear_gradient"
        ]
      },
      "citation_id": "cite.leave_patina.artifact.hidden_finish_boundary"
    },
    {
      "source_ref": "src.leave_patina.document.service_note",
      "kind": "DOCUMENT",
      "runtime_ref_id": "document_07",
      "document_id": "doc.leave_patina.household_service_note",
      "public_clue_id": "PROVENANCE",
      "reliability": "MEDIUM",
      "label": {
        "en": "Riverside household service note",
        "ko": "강변 저택 관리 기록"
      },
      "text": {
        "en": "The fictional household note identifies Eldermere music box E-52 in the riverside music room across three dated inventories and records it as already 'deep brown at the handled edges' before a 1951 winter treatment. It then lists one light coat of amber furniture wax after soot entered through a blocked flue.",
        "ko": "가상의 저택 관리 기록은 날짜가 있는 세 차례 목록에서 강변 저택 음악실의 엘더미어 오르골 E-52를 확인하고, 1951년 겨울 처리 전부터 '손이 닿는 가장자리까지 짙은 갈색'이었다고 적는다. 이어 막힌 연통으로 그을음이 들어온 뒤 호박색 가구 왁스를 얇게 한 번 발랐다고 기록한다."
      },
      "unlock": {
        "action": "read_document",
        "target": "document_07",
        "requires": [
          "src.leave_patina.artifact.wear_gradient"
        ]
      },
      "risk": {
        "destroyed_by": []
      },
      "independence": {
        "group": "household_treatment_record",
        "depends_on": [
          "src.leave_patina.artifact.wear_gradient"
        ]
      },
      "citation_id": "cite.leave_patina.document.service_note"
    },
    {
      "source_ref": "src.leave_patina.npc.iris_assessment",
      "kind": "NPC_STATEMENT",
      "runtime_ref_id": "iris_bell",
      "npc_id": "iris_bell",
      "expression": "thoughtful",
      "reliability": "MEDIUM",
      "label": {
        "en": "Iris Bell's treatment assessment",
        "ko": "아이리스 벨의 처리 소견"
      },
      "text": {
        "en": "Iris says the loose amber film resembles aged furniture wax, but the compact layer beneath behaves like an older oxidized finish. She cautions that her visual assessment needs the hidden-boundary test and service note before it can guide treatment.",
        "ko": "아이리스는 느슨한 호박색 막은 오래된 가구 왁스와 비슷하지만 아래의 치밀한 층은 더 오래 산화된 마감처럼 반응한다고 말한다. 다만 처리 방향을 정하려면 가려진 경계 시험과 관리 기록을 함께 확인해야 한다고 선을 긋는다."
      },
      "unlock": {
        "action": "ask_npc",
        "target": "iris_bell",
        "requires": [
          "src.leave_patina.document.service_note"
        ]
      },
      "risk": {
        "destroyed_by": []
      },
      "independence": {
        "group": "conservator_assessment",
        "depends_on": [
          "src.leave_patina.document.service_note"
        ]
      },
      "citation_id": "cite.leave_patina.npc.iris_assessment"
    },
    {
      "source_ref": "src.leave_patina.reference.eldemere_finish",
      "kind": "REFERENCE",
      "runtime_ref_id": "period_ref_13",
      "reference_id": "ref.eldemere.finish_1932_1943",
      "reliability": "HIGH",
      "label": {
        "en": "Eldermere finish guide, 1932–1943",
        "ko": "엘더미어 마감 지침, 1932~1943년"
      },
      "text": {
        "en": "The fictional period guide describes a transparent brown oil-resin finish that darkens in recesses and lightens at repeated touch points. Its workshop sample shows no opaque pigment pooling, unlike the artificial aging recipes listed in a later appendix.",
        "ko": "가상의 당대 지침은 오목한 곳에서 짙어지고 반복해서 만지는 곳에서 밝아지는 투명한 갈색 유성 수지 마감을 설명한다. 공방 표본에는 후대 부록의 인위적 노화법과 달리 불투명 안료가 고인 흔적이 없다."
      },
      "unlock": {
