    "display_name": {
      "en": "Venn Workshop Mantel Clock IV-417",
      "ko": "벤 공방 탁상시계 IV-417"
    },
    "authoring_truth_hypothesis_id": "hyp.period_repair",
    "player_prompt": {
      "en": "Record physical observations before cleaning or disassembly changes the object.",
      "ko": "세척이나 분해로 물건이 달라지기 전에 물리적 관찰을 기록하라."
    }
