  "hypotheses": [
    {
      "id": "hyp.garage_lamp.untouched_original",
      "label": {"en": "Untouched original", "ko": "손대지 않은 원형"},
      "claim": {
        "en": "The shell, socket, wiring, and fasteners all remain as Gildspire first assembled them.",
        "ko": "외피, 소켓, 배선과 고정 나사가 모두 길드스파이어 출고 당시 그대로 남아 있다."
      }
    },
    {
      "id": "hyp.garage_lamp.genuine_period_repair",
      "label": {"en": "Genuine with period repair", "ko": "당대 수리가 있는 진품"},
      "claim": {
        "en": "The Gildspire body is genuine and received a documented socket-and-cord repair while the lamp was still in garage service.",
        "ko": "길드스파이어 몸체는 진품이며 차고에서 사용되던 시기에 기록된 소켓·전선 수리를 받았다."
      }
    },
    {
      "id": "hyp.garage_lamp.modern_assembly_old_shell",
      "label": {"en": "Modern assembly, old shell", "ko": "오래된 외피의 현대 조립품"},
      "claim": {
        "en": "A recent maker assembled the lamp around an old brass shell using later internal parts and an invented history.",
        "ko": "최근 제작자가 오래된 황동 외피에 후대 내부 부품을 조립하고 이력을 꾸며 냈다."
      }
    }
  ],
  "sources": [
    {
      "source_ref": "src.garage_lamp.artifact.shell_wear_stamp",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_007",
      "reliability": "HIGH",
      "label": {"en": "Shell wear and maker stamp", "ko": "외피 마모와 제작사 각인"},
      "text": {
        "en": "The underside carries the struck mark Gildspire GL-307 beneath the same oxidation layer as the base. Repeated bench contact has flattened the rear foot and worn through lacquer gradually; the wear continues across the socket bracket instead of stopping at a newly assembled joint.",
        "ko": "밑면에는 받침과 같은 산화층 아래에 길드스파이어 GL-307 타각이 남아 있다. 작업대에 반복해서 닿은 뒤쪽 발은 납작해지고 칠이 서서히 닳았으며, 마모는 새로 조립한 경계에서 끊기지 않고 소켓 브래킷까지 이어진다."
      },
      "unlock": {"action": "inspect", "target": "base_and_socket_bracket", "requires": []},
      "risk": {"destroyed_by": []},
      "independence": {"group": "physical_shell_history", "depends_on": []},
      "citation_id": "cite.garage_lamp.artifact.shell_wear_stamp"
    },
    {
      "source_ref": "src.garage_lamp.artifact.socket_service_marks",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_007",
      "reliability": "HIGH",
      "label": {"en": "Socket service marks", "ko": "소켓 수리 흔적"},
      "text": {
        "en": "With the socket collar supported, one screw reveals old opposing driver marks sealed beneath a dark shellac ring. The replacement socket and braided cord have age-consistent dust inside the protected channel, while the untouched bracket screws retain parallel factory slots.",
        "ko": "소켓 고리를 받친 채 확인하자 나사 하나에서 짙은 셸락 고리 아래 봉인된 오래된 반대 방향 드라이버 자국이 드러난다. 교체 소켓과 땋은 전선의 가려진 통로에는 연대에 맞는 먼지가 쌓였고, 손대지 않은 브래킷 나사는 평행한 출고 홈을 유지한다."
      },
      "unlock": {
        "action": "disassemble",
        "target": "socket_collar",
        "requires": ["src.garage_lamp.artifact.shell_wear_stamp", "precision_screwdriver"]
      },
      "risk": {
        "destroyed_by": [],
        "player_warning": {
          "en": "Support the collar and turn only the marked screw; slipping across the shellac ring will blur the service sequence.",
          "ko": "고리를 받치고 표시된 나사만 돌려라. 셸락 고리 위로 미끄러지면 수리 순서가 흐려진다."
        }
      },
      "independence": {
        "group": "internal_socket_sequence",
        "depends_on": ["src.garage_lamp.artifact.shell_wear_stamp"]
      },
      "citation_id": "cite.garage_lamp.artifact.socket_service_marks"
    },
    {
      "source_ref": "src.garage_lamp.document.service_receipt",
      "kind": "DOCUMENT",
      "runtime_ref_id": "document_13",
      "document_id": "doc.garage_lamp.gildspire_service_receipt",
      "public_clue_id": "PROVENANCE",
      "reliability": "HIGH",
      "label": {"en": "North Quay garage service receipt", "ko": "북부 부두 차고 수리 영수증"},
      "text": {
        "en": "The fictional 1911 receipt identifies lamp GL-307 at North Quay Motor Garage and lists one Gildspire service socket, braided cord, and shellac seal. A later stock check repeats the same lamp number and notes that the original brass body was retained.",
        "ko": "가상의 1911년 영수증은 북부 부두 자동차 차고의 램프 GL-307을 특정하고 길드스파이어 수리용 소켓, 땋은 전선과 셸락 봉인을 한 개씩 기록한다. 후대 재고 점검표도 같은 램프 번호를 반복하며 원래 황동 몸체를 유지했다고 적는다."
      },
      "unlock": {
        "action": "read_document",
        "target": "document_13",
        "requires": ["src.garage_lamp.artifact.shell_wear_stamp"]
      },
      "risk": {"destroyed_by": []},
      "independence": {
        "group": "garage_service_record",
        "depends_on": ["src.garage_lamp.artifact.shell_wear_stamp"]
      },
      "citation_id": "cite.garage_lamp.document.service_receipt"
    },
    {
      "source_ref": "src.garage_lamp.npc.mara_assessment",
      "kind": "NPC_STATEMENT",
      "runtime_ref_id": "mara_venn",
      "npc_id": "mara_venn",
      "expression": "concerned",
      "reliability": "MEDIUM",
      "label": {"en": "Mara Venn's repair assessment", "ko": "마라 벤의 수리 소견"},
      "text": {
        "en": "Mara says the sealed driver marks and protected dust are consistent with an old service intervention, not a recent decorative rebuild. She treats the receipt and socket examination as the evidence, and her judgement only as a conservation cross-check.",
        "ko": "마라는 봉인된 드라이버 자국과 가려진 먼지가 최근 장식용 재조립이 아니라 오래된 사용 중 수리와 일치한다고 말한다. 다만 영수증과 소켓 검사를 증거로 삼고 자신의 판단은 보존 처리상의 교차 점검으로만 둔다."
      },
      "unlock": {
        "action": "ask_npc",
        "target": "mara_venn",
        "requires": ["src.garage_lamp.artifact.socket_service_marks", "src.garage_lamp.document.service_receipt"]
      },
      "risk": {"destroyed_by": []},
      "independence": {
        "group": "conservator_cross_check",
        "depends_on": ["src.garage_lamp.artifact.socket_service_marks", "src.garage_lamp.document.service_receipt"]
      },
      "citation_id": "cite.garage_lamp.npc.mara_assessment"
    },
    {
      "source_ref": "src.garage_lamp.reference.gildspire_service_sheet",
      "kind": "REFERENCE",
      "runtime_ref_id": "history_07",
      "reference_id": "ref.gildspire.service_sheet_1908_1912",
      "reliability": "HIGH",
      "label": {"en": "Gildspire service sheet, 1908–1912", "ko": "길드스파이어 수리 지침, 1908~1912년"},
      "text": {
        "en": "The fictional Gildspire sheet assigns GL-300 service sockets a single opposing screw mark and a dark shellac seal, while preserving the original bracket and body. Its modern-rebuild appendix shows plastic insulation and machine-clean fasteners absent from GL-307.",
        "ko": "가상의 길드스파이어 지침은 GL-300 계열 수리 소켓에 반대 방향 나사 자국 하나와 짙은 셸락 봉인을 남기되 원래 브래킷과 몸체를 유지하라고 한다. 현대 재조립 부록의 플라스틱 절연재와 기계처럼 깨끗한 고정 나사는 GL-307에서 보이지 않는다."
      },
      "unlock": {
        "action": "query_reference",
        "target": "reference_database",
        "requires": ["src.garage_lamp.artifact.socket_service_marks", "reference_database"]
      },
      "risk": {"destroyed_by": []},
      "independence": {
        "group": "independent_maker_reference",
        "depends_on": ["src.garage_lamp.artifact.socket_service_marks"]
      },
      "citation_id": "cite.garage_lamp.reference.gildspire_service_sheet"
    }
  ],
