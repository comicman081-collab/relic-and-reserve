  "hypotheses": [
    {
      "id": "hyp.mislabelled_collection.matched_collection_label",
      "label": {"en": "Correct collection label", "ko": "일치하는 소장품 라벨"},
      "claim": {
        "en": "The period Rook projector and its present collection label have always belonged together.",
        "ko": "당대 룩 영사기와 현재 소장품 라벨은 처음부터 함께해 왔다."
      }
    },
    {
      "id": "hyp.mislabelled_collection.genuine_projector_swapped_accession_label",
      "label": {"en": "Genuine projector, swapped label", "ko": "진품 영사기와 뒤바뀐 라벨"},
      "claim": {
        "en": "The Rook Model 117 projector is genuine, but a later collection move gave it another object's accession label.",
        "ko": "룩 모델 117 영사기는 진품이지만 후대 소장품 이동 중 다른 물건의 등록 라벨이 붙었다."
      }
    },
    {
