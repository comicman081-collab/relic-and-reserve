  "hypotheses": [
    {
      "id": "hyp.telephone_trace.untouched_original",
      "label": {"en": "Untouched original", "ko": "손대지 않은 원형"},
      "claim": {
        "en": "The shell, cord, fuse, and terminal hardware all remain from Orchard's original production.",
        "ko": "외피, 전선, 퓨즈와 단자 철물이 모두 오처드 출고 당시 그대로 남아 있다."
      }
    },
    {
      "id": "hyp.telephone_trace.genuine_modern_safety_repair",
      "label": {"en": "Genuine with modern safety repair", "ko": "현대 안전 수리가 있는 진품"},
      "claim": {
        "en": "The early Orchard telephone is genuine, but its power lead and terminal protection were replaced in a documented modern safety intervention.",
        "ko": "초기 오처드 전화기는 진품이지만 전원선과 단자 보호 부품은 기록이 남은 현대 안전 작업에서 교체되었다."
      }
    },
    {
      "id": "hyp.telephone_trace.later_parts_reproduction",
      "label": {"en": "Later-parts reproduction", "ko": "후대 부품 복제품"},
      "claim": {
        "en": "A later assembler combined a reproduction shell and mixed hardware, then attached an old-style Orchard identity.",
        "ko": "후대 조립자가 복제 외피와 여러 철물을 합친 뒤 오래된 오처드식 정체성을 붙였다."
      }
    }
  ],
  "sources": [
    {
      "source_ref": "src.telephone_trace.artifact.shell_material_serial",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_015",
      "reliability": "HIGH",
      "label": {"en": "Bakelite shell and serial", "ko": "베이클라이트 외피와 일련번호"},
      "text": {
        "en": "A calibrated material scan finds the dark shell's filler and phenolic response consistent across protected and exposed areas. The moulded OT-114 serial sits beneath age cracking rather than above it, and the handset cradle wear follows the same long use pattern.",
        "ko": "보정된 재료 스캔에서 짙은 외피의 충전재와 페놀 반응이 가려진 곳과 노출된 곳에서 일치한다. 성형된 OT-114 일련번호는 노화 균열 위가 아니라 아래에 있고, 송수화기 받침의 마모도 같은 장기 사용 양상을 따른다."
      },
      "unlock": {"action": "inspect", "target": "bakelite_shell", "requires": ["material_scanner"]},
      "risk": {
        "destroyed_by": [],
        "player_warning": {
          "en": "Use one calibrated pass on the protected rim; repeated scanning can warm the brittle filler.",
          "ko": "가려진 테두리에 보정된 스캔을 한 번만 실시하라. 반복 스캔은 취약한 충전재를 달굴 수 있다."
        }
      },
      "independence": {"group": "shell_material_identity", "depends_on": []},
      "citation_id": "cite.telephone_trace.artifact.shell_material_serial"
    },
    {
      "source_ref": "src.telephone_trace.artifact.terminal_safety_repair",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_015",
      "reliability": "HIGH",
      "label": {"en": "Terminal-block safety repair", "ko": "단자대 안전 수리"},
      "text": {
        "en": "Before power is applied, the opened base shows a modern strain relief, insulated crimp, and inline fuse mounted through older holes. Oxidized witness marks preserve the outline of the removed cloth lead, while the original induction coil and stamped chassis remain undisturbed.",
        "ko": "전원을 넣기 전 바닥을 열어 보니 현대식 변형 방지 고정부, 절연 압착 단자와 인라인 퓨즈가 오래된 구멍을 이용해 장착되어 있다. 산화된 접촉 흔적에는 제거된 천 피복 전선의 윤곽이 남고, 원래 유도 코일과 타각 섀시는 손대지 않았다."
      },
      "unlock": {
        "action": "disassemble",
        "target": "terminal_block",
        "requires": ["src.telephone_trace.artifact.shell_material_serial", "precision_screwdriver"]
      },
      "risk": {
        "destroyed_by": ["energize_before_terminal_capture"],
        "player_warning": {
          "en": "Photograph the cold terminal block before moving a screw or applying power; heat can erase the contact outline.",
          "ko": "나사를 움직이거나 전원을 넣기 전에 차가운 단자대를 촬영하라. 열은 접촉 윤곽을 지울 수 있다."
        }
      },
      "independence": {
        "group": "internal_electrical_sequence",
        "depends_on": ["src.telephone_trace.artifact.shell_material_serial"]
      },
      "citation_id": "cite.telephone_trace.artifact.terminal_safety_repair"
    },
    {
      "source_ref": "src.telephone_trace.document.safety_repair_log",
      "kind": "DOCUMENT",
      "runtime_ref_id": "document_15",
      "document_id": "doc.telephone_trace.safety_repair_log",
      "public_clue_id": "PROVENANCE",
      "reliability": "HIGH",
      "label": {"en": "Orchard OT-114 safety repair log", "ko": "오처드 OT-114 안전 수리 기록"},
      "text": {
        "en": "The fictional 1986 workshop log records Orchard telephone OT-114 by moulded shell number. It lists replacement of the perished cloth power lead, addition of an inline fuse and insulated crimp, and retention of the original chassis, coil, bell, and handset.",
        "ko": "가상의 1986년 공방 기록은 성형 외피 번호로 오처드 전화기 OT-114를 특정한다. 삭은 천 피복 전원선 교체, 인라인 퓨즈와 절연 압착 단자 추가, 원래 섀시·코일·종·송수화기 유지가 기록되어 있다."
      },
      "unlock": {
        "action": "read_document",
        "target": "document_15",
        "requires": ["src.telephone_trace.artifact.shell_material_serial"]
      },
      "risk": {"destroyed_by": []},
      "independence": {
        "group": "modern_safety_record",
        "depends_on": ["src.telephone_trace.artifact.shell_material_serial"]
      },
      "citation_id": "cite.telephone_trace.document.safety_repair_log"
    },
    {
      "source_ref": "src.telephone_trace.document.estate_inventory",
      "kind": "DOCUMENT",
      "runtime_ref_id": "document_16",
      "document_id": "doc.telephone_trace.estate_inventory_ot114",
      "reliability": "MEDIUM",
      "label": {"en": "Vale estate telephone inventory", "ko": "베일 저택 전화기 목록"},
      "text": {
        "en": "The fictional 1954 inventory lists black Orchard desk telephone OT-114 with a frayed cloth lead and the same chipped rear foot visible today. A 1986 margin note sends that numbered set for an electrical-safety refit and records its return.",
        "ko": "가상의 1954년 목록은 닳은 천 피복 전선과 현재도 보이는 뒤쪽 발의 깨짐을 가진 검은 오처드 탁상 전화기 OT-114를 적는다. 1986년 여백 메모에는 같은 번호의 전화기를 전기 안전 개수에 보냈다가 돌려받았다고 기록한다."
      },
      "unlock": {
        "action": "read_document",
        "target": "document_16",
        "requires": ["src.telephone_trace.document.safety_repair_log"]
      },
      "risk": {"destroyed_by": []},
      "independence": {
        "group": "estate_object_continuity",
        "depends_on": ["src.telephone_trace.document.safety_repair_log"]
      },
      "citation_id": "cite.telephone_trace.document.estate_inventory"
    },
    {
      "source_ref": "src.telephone_trace.npc.noah_archive_context",
      "kind": "NPC_STATEMENT",
      "runtime_ref_id": "noah_stern",
      "npc_id": "noah_stern",
      "expression": "concerned",
      "reliability": "MEDIUM",
      "label": {"en": "Noah Stern's archive context", "ko": "노아 스턴의 기록 맥락"},
      "text": {
        "en": "Noah says the two records entered the archive from different custodians and agree on the moulded number and damaged rear foot. He cautions that this supports continuity of the body, while the physical terminal block must establish what was replaced.",
        "ko": "노아는 두 기록이 서로 다른 보관자에게서 기록관으로 들어왔고 성형 번호와 뒤쪽 발 손상에 관해 일치한다고 말한다. 다만 이는 몸체의 연속성을 뒷받침할 뿐, 무엇이 교체되었는지는 실물 단자대가 밝혀야 한다고 선을 긋는다."
      },
      "unlock": {
        "action": "ask_npc",
        "target": "noah_stern",
        "requires": ["src.telephone_trace.document.safety_repair_log", "src.telephone_trace.document.estate_inventory"]
      },
      "risk": {"destroyed_by": []},
      "independence": {
        "group": "archive_custody_context",
        "depends_on": ["src.telephone_trace.document.safety_repair_log", "src.telephone_trace.document.estate_inventory"]
      },
      "citation_id": "cite.telephone_trace.npc.noah_archive_context"
    },
    {
      "source_ref": "src.telephone_trace.reference.orchard_wiring_guide",
      "kind": "REFERENCE",
      "runtime_ref_id": "history_15",
      "reference_id": "ref.orchard.ot100_wiring_and_retrofit",
      "reliability": "HIGH",
      "label": {"en": "Orchard OT-100 wiring guide", "ko": "오처드 OT-100 배선 지침"},
      "text": {
        "en": "The fictional Orchard guide matches the shell filler, coil layout, and OT-100 moulded numbering to early production. Its later safety appendix specifies the same fused lead and insulated crimp found in OT-114, while reproduction shells use a different filler and printed serial plate.",
        "ko": "가상의 오처드 지침은 외피 충전재, 코일 배치와 OT-100 성형 번호를 초기 생산품과 연결한다. 후대 안전 부록은 OT-114에서 확인한 퓨즈 전선과 절연 압착 단자를 명시하고, 복제품 외피에는 다른 충전재와 인쇄 일련번호판을 사용한다고 적는다."
      },
      "unlock": {
        "action": "query_reference",
        "target": "reference_database",
        "requires": ["src.telephone_trace.artifact.terminal_safety_repair", "reference_database"]
      },
      "risk": {"destroyed_by": []},
      "independence": {
        "group": "independent_orchard_reference",
        "depends_on": ["src.telephone_trace.artifact.terminal_safety_repair"]
      },
      "citation_id": "cite.telephone_trace.reference.orchard_wiring_guide"
    }
  ],
