  "sources": [
    {
      "source_ref": "src.observatory_instrument.artifact.meridian_dial_material",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_011",
      "reliability": "HIGH",
      "label": {"en": "Meridian dial", "ko": "자오선 다이얼"},
      "short_observation": {
        "en": "The dial and sight form a period azimuth compass.",
        "ko": "다이얼과 조준기가 당대 방위 나침반을 이룬다."
      },
      "text": {
        "en": "A calibrated material scan finds one period alloy family across the Model 110 case, azimuth ring, meridian sight, and compass bowl. The sight reads a horizontal bearing against the meridian mark; there is no lens tube or optical focus path, so this is not a telescope.",
        "ko": "보정된 재료 스캔에서 모델 110 케이스, 방위 고리, 자오선 조준기와 나침반 그릇이 하나의 당대 합금 계열로 확인된다. 조준기는 자오선 표시에 맞춰 수평 방위를 읽으며 렌즈 통이나 광학 초점 경로가 없어 망원경이 아니다."
      },
      "unlock": {
        "action": "scan_material",
        "target": "meridian_dial_and_case",
        "requires": ["material_scanner"],
        "action_label": {"en": "Scan dial materials", "ko": "다이얼 재료 스캔"},
        "target_label": {"en": "Meridian dial and case", "ko": "자오선 다이얼과 케이스"}
      },
      "risk": {
        "destroyed_by": [],
        "player_warning": {
          "en": "Use one low-power pass around the painted meridian mark to avoid warming its binder.",
          "ko": "도료 결합제가 달아오르지 않도록 자오선 표시 둘레를 저출력으로 한 번만 스캔하라."
        }
      },
      "independence": {"group": "physical_observatory_identity", "depends_on": []},
      "citation_id": "cite.observatory_instrument.artifact.meridian_dial_material"
    },
    {
      "source_ref": "src.observatory_instrument.artifact.pivot_repair_sequence",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_011",
      "reliability": "HIGH",
      "label": {"en": "Pivot repair", "ko": "피벗 수리"},
      "short_observation": {
        "en": "Period tool marks reveal a fitted pivot and jewel.",
        "ko": "당대 공구 흔적이 맞춤 피벗과 보석 베어링을 드러낸다."
      },
      "text": {
        "en": "After the cap alignment is photographed, precision disassembly reveals an older seating scar beneath a fitted pivot and jewel bearing. Matching oxidation bridges the replacement parts and surrounding plate, while Kestrel service punch marks predate the final working wear.",
        "ko": "캡 정렬을 촬영한 뒤 정밀 분해하자 맞춤 피벗과 보석 베어링 아래에 이전 안착 흔적이 드러난다. 교체 부품과 주변 판을 잇는 산화가 일치하고 케스트럴 정비 타각은 마지막 사용 마모보다 앞선다."
      },
      "unlock": {
        "action": "disassemble",
        "target": "pivot_cap",
        "requires": [
          "src.observatory_instrument.artifact.meridian_dial_material",
          "precision_screwdriver"
        ],
        "action_label": {"en": "Open pivot cap", "ko": "피벗 캡 열기"},
        "target_label": {"en": "Compass pivot cap", "ko": "나침반 피벗 캡"}
      },
      "risk": {
        "destroyed_by": ["remove_pivot_cap_without_alignment_capture"],
        "player_warning": {
          "en": "Photograph the cap alignment before loosening it; a shifted index can erase the repair sequence.",
          "ko": "캡을 풀기 전에 정렬 상태를 촬영하라. 기준점이 움직이면 수리 순서를 판별할 흔적이 사라질 수 있다."
        }
      },
      "independence": {
        "group": "internal_pivot_sequence",
        "depends_on": ["src.observatory_instrument.artifact.meridian_dial_material"]
      },
      "citation_id": "cite.observatory_instrument.artifact.pivot_repair_sequence"
    },
    {
      "source_ref": "src.observatory_instrument.document.auction_receipt",
      "kind": "DOCUMENT",
      "runtime_ref_id": "document_23",
      "document_id": "doc.observatory_instrument.observatory_transfer_receipt",
      "public_clue_id": "PROVENANCE",
      "reliability": "HIGH",
      "label": {"en": "Observatory transfer receipt", "ko": "천문대 이관 영수증"},
      "short_observation": {
        "en": "The receipt tracks the numbered compass from its observatory.",
        "ko": "영수증이 번호가 있는 나침반의 천문대 이력을 잇는다."
      },
      "text": {
        "en": "The fictional transfer receipt lists a Kestrel Model 110 meridian-and-azimuth compass by its case number and observatory station. It records the same dent and dial range seen today and calls the object a compass, not a telescope.",
        "ko": "가상의 이관 영수증은 케이스 번호와 천문대 관측 지점으로 케스트럴 모델 110 자오선·방위 나침반을 특정한다. 현재와 같은 찌그러짐과 다이얼 범위를 기록하며 물건을 망원경이 아니라 나침반이라고 부른다."
      },
      "unlock": {
        "action": "read_document",
        "target": "observatory_transfer_receipt",
        "requires": [],
        "action_label": {"en": "Read transfer receipt", "ko": "이관 영수증 읽기"},
        "target_label": {"en": "Observatory transfer receipt", "ko": "천문대 이관 영수증"}
      },
      "risk": {"destroyed_by": []},
      "independence": {"group": "observatory_transfer_chain", "depends_on": []},
      "citation_id": "cite.observatory_instrument.document.auction_receipt"
    },
    {
      "source_ref": "src.observatory_instrument.document.pivot_service_card",
      "kind": "DOCUMENT",
      "runtime_ref_id": "document_24",
      "document_id": "doc.observatory_instrument.pivot_service_card",
      "reliability": "HIGH",
      "label": {"en": "Pivot service card", "ko": "피벗 정비 카드"},
      "short_observation": {
        "en": "The service card dates the pivot repair to working life.",
        "ko": "정비 카드가 피벗 수리를 사용 시기로 확정한다."
      },
      "text": {
        "en": "The fictional Kestrel service card matches the punch sequence exposed beneath the cap. It records fitting a new pivot and jewel bearing during the compass's working life, but contains no ownership transfer and therefore is not provenance.",
        "ko": "가상의 케스트럴 정비 카드는 캡 아래에서 확인한 타각 순서와 일치한다. 나침반 사용 시기에 새 피벗과 보석 베어링을 맞췄다고 기록하지만 소유권 이전 내용이 없어 소장 이력 증거는 아니다."
      },
      "unlock": {
        "action": "read_document",
        "target": "pivot_service_card",
        "requires": [
          "src.observatory_instrument.artifact.pivot_repair_sequence",
          "src.observatory_instrument.document.auction_receipt"
        ],
        "action_label": {"en": "Match service card", "ko": "정비 카드 대조"},
        "target_label": {"en": "Pivot service card", "ko": "피벗 정비 카드"}
      },
      "risk": {"destroyed_by": []},
      "independence": {
        "group": "period_service_record",
        "depends_on": [
          "src.observatory_instrument.artifact.pivot_repair_sequence",
          "src.observatory_instrument.document.auction_receipt"
        ]
      },
      "citation_id": "cite.observatory_instrument.document.pivot_service_card"
    },
    {
      "source_ref": "src.observatory_instrument.npc.hana_meridian_context",
      "kind": "NPC_STATEMENT",
      "runtime_ref_id": "hana_mire",
      "npc_id": "hana_mire",
      "expression": "positive",
      "reliability": "MEDIUM",
      "label": {"en": "Dr. Hana Mire's instrument review", "ko": "하나 미레 박사의 기구 검토"},
      "short_observation": {
        "en": "Dr. Hana Mire confirms compass function and limited repair scope.",
        "ko": "하나 미레 박사가 나침반 기능과 제한된 수리 범위를 확인한다."
      },
      "text": {
        "en": "Dr. Hana Mire explains that an observatory used this compass to transfer a meridian reference and check azimuth before other observations. The receipt establishes custody; the service card and physical punch marks independently limit the intervention to the pivot assembly.",
        "ko": "하나 미레 박사는 천문대가 다른 관측에 앞서 자오선 기준을 옮기고 방위를 확인하는 데 이 나침반을 사용했다고 설명한다. 이관 영수증은 소장 이력을, 정비 카드와 실물 타각은 수리가 피벗 조립부에 한정됐음을 각각 보여 준다."
      },
      "unlock": {
