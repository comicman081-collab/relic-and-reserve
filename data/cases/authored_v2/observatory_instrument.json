    {
      "source_ref": "src.observatory_instrument.reference.kestrel_model110_guide",
      "kind": "REFERENCE",
      "runtime_ref_id": "history_11",
      "reference_id": "ref.kestrel.model110_observatory_guide",
      "reliability": "HIGH",
      "label": {"en": "Kestrel model guide", "ko": "케스트럴 모델 안내서"},
      "short_observation": {
        "en": "The guide matches compass construction and period repair marks.",
        "ko": "안내서가 나침반 구조와 당대 수리 표식을 확인한다."
      },
      "text": {
        "en": "The fictional Kestrel guide identifies Model 110 as a meridian-and-azimuth reference compass and matches its case, sight, and dial construction. A service appendix illustrates the same period pivot punch pattern; later display copies use a decorative optical tube absent here.",
        "ko": "가상의 케스트럴 안내서는 모델 110을 자오선·방위 기준 나침반으로 분류하고 케이스, 조준기와 다이얼 구조를 실물과 연결한다. 정비 부록은 같은 당대 피벗 타각 방식을 보여 주며 후대 전시 복제품에는 이 실물에 없는 장식용 광학 통이 달려 있다."
      },
