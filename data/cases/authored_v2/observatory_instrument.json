        ],
        "action_label": {"en": "Ask Dr. Mire", "ko": "미레 박사에게 묻기"},
        "target_label": {"en": "Dr. Hana Mire", "ko": "하나 미레 박사"}
      },
      "risk": {"destroyed_by": []},
