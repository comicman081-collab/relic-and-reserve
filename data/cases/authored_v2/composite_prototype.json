  "hypotheses": [
    {
      "id": "hyp.composite_prototype.genuine_experimental_prototype",
      "label": {"en": "Genuine experimental prototype", "ko": "진짜 실험 시제품"},
      "claim": {
        "en": "Solenne built the dial, carriage, counter, and base together as one undocumented experimental instrument.",
        "ko": "솔렌이 다이얼, 이동대, 계수기와 받침을 하나의 미기록 실험 기구로 함께 제작했다."
      }
    },
    {
      "id": "hyp.composite_prototype.genuine_instrument_with_later_adapter",
      "label": {"en": "Genuine instrument, later adapter", "ko": "진품 기구와 후대 어댑터"},
      "claim": {
        "en": "A genuine Solenne measuring body received one limited later adapter while its original mechanism remained intact.",
        "ko": "진짜 솔렌 측정 기구 몸체에 제한적인 후대 어댑터 하나가 붙었고 원래 기구부는 온전히 남았다."
      }
    },
    {
      "id": "hyp.composite_prototype.composite_forgery_from_mixed_parts",
      "label": {"en": "Composite forgery from mixed parts", "ko": "서로 다른 부품의 복합 위조품"},
      "claim": {
        "en": "Parts from different instruments and dates were joined with modern adapters, renumbered, and aged together to imitate a rare prototype.",
        "ko": "서로 다른 기구와 연대의 부품을 현대 어댑터로 잇고 번호와 노화를 함께 꾸며 희귀 시제품처럼 만들었다."
      }
    }
  ],
  "sources": [
    {
      "source_ref": "src.composite_prototype.artifact.mixed_period_components",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_059",
      "reliability": "HIGH",
      "label": {"en": "Component balance survey", "ko": "부품 균형 조사"},
      "short_observation": {"en": "Three assemblies divide into incompatible weight families.", "ko": "세 조립부가 맞지 않는 질량 계열로 나뉜다."},
      "text": {
        "en": "Supported precision measurements separate the dial body, drafting carriage, and counter into three incompatible mass and balance families. Their shared brown coating hides distinct wear edges, and only the base follows the claimed Solenne proportion.",
        "ko": "각 부품을 받친 정밀 측정에서 다이얼 몸체, 제도용 이동대와 계수기가 서로 맞지 않는 세 질량·균형 계열로 갈린다. 공통 갈색 도막은 서로 다른 마모 가장자리를 가리고, 받침만 주장된 솔렌 비례를 따른다."
      },
      "unlock": {
        "action": "measure",
        "target": "dial_carriage_and_counter",
        "requires": ["precision_scale"],
        "action_label": {"en": "Measure components", "ko": "부품 측정"},
        "target_label": {"en": "Dial, carriage, and counter", "ko": "다이얼, 이동대와 계수기"}
      },
      "risk": {
        "destroyed_by": [],
        "player_warning": {"en": "Support every joint before shifting the instrument.", "ko": "기구를 옮기기 전에 모든 접합부를 받쳐라."}
      },
      "independence": {"group": "component_mass_mismatch", "depends_on": []},
      "citation_id": "cite.composite_prototype.artifact.mixed_period_components"
    },
    {
      "source_ref": "src.composite_prototype.artifact.modern_adapter_construction",
      "kind": "ARTIFACT_OBSERVATION",
      "runtime_ref_id": "artifact_059",
      "reliability": "HIGH",
      "label": {"en": "Hidden adapter network", "ko": "숨은 어댑터 구조"},
      "short_observation": {"en": "Modern adapters join three unrelated numbering systems.", "ko": "현대 어댑터가 서로 다른 세 번호 체계를 잇는다."},
      "text": {
        "en": "After every joint is photographed, the repair toolkit exposes machine-cut shims, fresh epoxy, and three unrelated numbering sequences beneath the base. The adapters join all major modules at once rather than marking one limited repair, and the applied grime continues across the new seams.",
        "ko": "모든 접합부를 촬영한 뒤 수리 도구로 받침을 열자 기계 절단 심, 새 에폭시와 서로 다른 세 번호 배열이 드러난다. 어댑터는 제한적인 수리 한 곳이 아니라 주요 모듈 전체를 한꺼번에 잇고, 덧바른 오염도 새 이음새를 가로질러 이어진다."
      },
      "unlock": {
        "action": "disassemble",
        "target": "indexed_composite_base",
        "requires": ["src.composite_prototype.artifact.mixed_period_components", "repair_toolkit"],
        "action_label": {"en": "Open the indexed base", "ko": "기준 표시 받침 열기"},
        "target_label": {"en": "Shims, epoxy, and numbering", "ko": "심, 에폭시와 번호 배열"}
      },
      "risk": {
        "destroyed_by": ["open_base_without_joint_capture"],
        "player_warning": {"en": "Photograph every joint before loosening the base.", "ko": "받침을 풀기 전에 모든 접합부를 촬영하라."}
      },
      "independence": {"group": "modern_adapter_network", "depends_on": ["src.composite_prototype.artifact.mixed_period_components"]},
      "citation_id": "cite.composite_prototype.artifact.modern_adapter_construction"
    },
    {
      "source_ref": "src.composite_prototype.document.archive_custody_record",
      "kind": "DOCUMENT",
      "runtime_ref_id": "document_09",
      "document_id": "doc.composite_prototype.archive_custody_record",
      "public_clue_id": "PROVENANCE",
      "reliability": "HIGH",
      "label": {"en": "Recent archive custody record", "ko": "최근 보관 소장 기록"},
      "short_observation": {"en": "The signed chain starts after the composite already existed.", "ko": "서명된 소장 경로가 복합 조립 이후에 시작된다."},
      "text": {
        "en": "Fictional Archive Record 09 first describes the complete composite in a recent unverified donation, then follows it through signed storage transfers. It proves custody only from that intake and contains no workshop entry or earlier owner; this is the case's sole provenance record.",
        "ko": "가상 보관 기록 09는 최근의 미검증 기증에서 완성된 복합 기구를 처음 적고 이후 서명된 보관 이관을 잇는다. 이 기록은 그 입고 시점 이후의 소장만 증명하고 공방 입고나 이전 소유자는 담지 않으며, 이것이 이 사건의 유일한 소장 이력 기록이다."
      },
      "unlock": {
        "action": "read_document",
        "target": "recent_archive_custody_record",
        "requires": [],
        "action_label": {"en": "Read custody record", "ko": "소장 기록 읽기"},
        "target_label": {"en": "Signed archive transfers", "ko": "서명된 보관 이관"}
      },
      "risk": {"destroyed_by": []},
      "independence": {"group": "composite_archive_chain", "depends_on": []},
      "citation_id": "cite.composite_prototype.document.archive_custody_record"
    },
    {
      "source_ref": "src.composite_prototype.document.reserve_catalog_entry",
      "kind": "DOCUMENT",
      "runtime_ref_id": "document_20",
      "document_id": "doc.composite_prototype.reserve_catalog_entry",
      "reliability": "MEDIUM",
      "label": {"en": "Model 158 catalog entry", "ko": "모델 158 카탈로그 항목"},
      "short_observation": {"en": "The catalog shows one cast frame and one serial sequence.", "ko": "카탈로그는 단일 주조 프레임과 번호 배열을 보여 준다."},
      "text": {
        "en": "Fictional Reserve Catalog 20 diagrams the Model 158 as one cast measuring frame with an integrated carriage and a single serial sequence. It lists no detachable counter, shimmed joints, or experimental composite version. The entry describes construction only and is not provenance.",
        "ko": "가상 보관소 카탈로그 20은 모델 158을 이동대가 통합된 단일 주조 측정 프레임과 하나의 일련번호 배열로 도해한다. 분리형 계수기, 심을 댄 접합부나 실험용 복합판은 적혀 있지 않다. 이 항목은 제작법만 설명하며 소장 이력은 아니다."
      },
      "unlock": {
        "action": "compare_records",
        "target": "model158_catalog_entry",
        "requires": ["src.composite_prototype.artifact.mixed_period_components"],
        "action_label": {"en": "Compare catalog", "ko": "카탈로그 대조"},
        "target_label": {"en": "Model 158 construction plate", "ko": "모델 158 제작 도판"}
      },
      "risk": {"destroyed_by": []},
      "independence": {"group": "composite_reserve_catalog", "depends_on": ["src.composite_prototype.artifact.mixed_period_components"]},
      "citation_id": "cite.composite_prototype.document.reserve_catalog_entry"
    },
    {
      "source_ref": "src.composite_prototype.npc.noah_prototype_context",
      "kind": "NPC_STATEMENT",
      "runtime_ref_id": "noah_stern",
      "npc_id": "noah_stern",
      "expression": "concerned",
      "reliability": "MEDIUM",
      "label": {"en": "Noah's acquisition account", "ko": "노아의 입수 경위"},
      "short_observation": {"en": "The prototype claim came from an unsigned crate tag.", "ko": "시제품 주장은 서명 없는 상자 표찰에서 나왔다."},
      "text": {
        "en": "Noah says the broker called the object a prototype because an unsigned crate tag used that word. He has no maker letter or earlier owner and asks that the component measurements, hidden joints, catalog, and signed custody record carry the conclusion.",
        "ko": "노아는 서명 없는 상자 표찰에 시제품이라는 말이 있어 중개상이 그렇게 불렀다고 말한다. 제작사 편지나 이전 소유자는 없으며, 부품 측정, 숨은 접합부, 카탈로그와 서명된 소장 기록으로 결론을 내려 달라고 요청한다."
      },
      "unlock": {
        "action": "ask_npc",
        "target": "noah_stern",
        "requires": ["src.composite_prototype.document.archive_custody_record"],
        "action_label": {"en": "Ask Noah", "ko": "노아에게 묻기"},
        "target_label": {"en": "Noah Stern", "ko": "노아 스턴"}
      },
      "risk": {"destroyed_by": []},
      "independence": {"group": "noah_prototype_account", "depends_on": ["src.composite_prototype.document.archive_custody_record"]},
      "citation_id": "cite.composite_prototype.npc.noah_prototype_context"
    },
    {
      "source_ref": "src.composite_prototype.reference.period_measuring_standard",
      "kind": "REFERENCE",
      "runtime_ref_id": "period_ref_13",
      "reference_id": "ref.composite_prototype.period_measuring_standard",
      "reliability": "HIGH",
      "label": {"en": "Period measuring standard", "ko": "당대 측정 기구 기준"},
      "short_observation": {"en": "The standard separates every module's date and purpose.", "ko": "기준 자료가 각 모듈의 연대와 용도를 구분한다."},
      "text": {
        "en": "The fictional 1932–1943 measuring standard matches the base alone to Solenne practice. The dial body, carriage, and counter follow three different workshop systems, while the machine-cut shims, epoxy, transferred number, and uniform grime are later joining methods rather than period experimentation.",
        "ko": "가상의 1932~1943년 측정 기구 기준에서 받침만 솔렌 관행에 맞는다. 다이얼 몸체, 이동대와 계수기는 서로 다른 세 공방 체계를 따르고, 기계 절단 심, 에폭시, 전사 번호와 균일한 오염은 당대 실험이 아닌 후대 결합 방식이다."
      },
      "unlock": {
        "action": "query_reference",
        "target": "reference_database",
        "requires": ["src.composite_prototype.artifact.mixed_period_components", "reference_database"],
        "action_label": {"en": "Check period standard", "ko": "당대 기준 확인"},
        "target_label": {"en": "Measuring construction guide", "ko": "측정 기구 제작 안내서"}
      },
      "risk": {"destroyed_by": []},
      "independence": {"group": "independent_measuring_standard", "depends_on": ["src.composite_prototype.artifact.mixed_period_components"]},
      "citation_id": "cite.composite_prototype.reference.period_measuring_standard"
    }
  ],
